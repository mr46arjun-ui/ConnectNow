# Required in production. On Render, do not use localhost: use the hostname
# supplied by your external MySQL provider or persistent private MySQL service.
DATABASE_URL=mysql://connectnow:change-me@mysql.example.com:3306/connectnow
# Enable TLS if required by the MySQL provider. DB_SSL_CA accepts PEM text with
# literal \n characters. Never use rejectUnauthorized=false in production.
DB_SSL=false
DB_SSL_CA=
DB_CONNECTION_LIMIT=10
JWT_SECRET=

# Server
NODE_ENV=development
PORT=3000
SESSION_ISSUER=connectnow
TRUST_PROXY=1
TRUST_PROXY_HOPS=1

# Database migrations run and schema is verified before the server accepts traffic.
RUN_DB_MIGRATIONS=true
DB_MIGRATION_ATTEMPTS=5
# MIGRATIONS_DIR=/app/drizzle

# OAuth is optional. Local email/password authentication is used by default.
VITE_ENABLE_OAUTH=false
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
APP_PUBLIC_ORIGIN=

# Optional real-time cross-origin clients (comma-separated)
ALLOWED_ORIGINS=

# Optional Redis
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Optional Manus/Forge integrations
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional analytics (both values are required to load analytics)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional TURN relay for reliable voice/video across restrictive networks.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional Tenor v2 key. Without it, the group picker uses its built-in curated
# GIF reactions; with it, users receive live search and paginated results.
VITE_TENOR_API_KEY=
